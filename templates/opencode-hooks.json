{
  "_comment": "OpenCode V2：原生扩展点是 JS/TS 插件（~/.config/opencode/plugins/ 或 plugins 配置），无 stdin/stdout JSON hook。本文件只描述「V2 插件 shell 调用 opencode_adapter.py」的桥接约定；实际插件见 plugins/opencode/index.js。官方文档 https://opencode.ai/docs/build/plugins",
  "hooks": {
    "SessionStart": [
      {
        "bridge": "opencode-plugin-shell-call",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHON_EXECUTABLE HOOKS_DIR/opencode_adapter.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "bridge": "opencode-plugin-shell-call",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHON_EXECUTABLE HOOKS_DIR/opencode_adapter.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
